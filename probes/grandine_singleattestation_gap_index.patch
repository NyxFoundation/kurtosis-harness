+    // --- CHK-QW-02 PoC accessors -------------------------------------------
+    // Deterministic in-process reproduction of the SingleAttestation
+    // out-of-band `attester_index` -> unguarded `justified_active_balances`
+    // panic. See `singleattestation_oob_attester_index_*` in `extra_tests`.
+
+    #[must_use]
+    pub fn poc_config(&self) -> &Config {
+        self.config()
+    }
+
+    #[must_use]
+    pub fn poc_pubkey_cache(&self) -> &Arc<PubkeyCache> {
+        &self.pubkey_cache
+    }
+
+    /// Apply a block via the gossip path and drain every resulting P2P message,
+    /// returning them for inspection (no acceptance assertion).
+    pub fn poc_apply_block(&mut self, block: &Arc<SignedBeaconBlock<P>>) -> Vec<P2pMessage<P>> {
+        self.controller()
+            .on_gossip_block(block.clone_arc(), GossipId::default());
+        self.controller().wait_for_tasks();
+        let mut messages = Vec::new();
+        while let Some(message) = self.next_p2p_message() {
+            messages.push(message);
+        }
+        messages
+    }
+
+    /// Notify the store that a block's execution payload is valid (drives the
+    /// optimistic import to full validity for post-merge blocks).
+    pub fn poc_notify_valid_payload(&mut self, block: &Arc<SignedBeaconBlock<P>>) {
+        self.on_notified_valid_payload(block);
+    }
+
+    /// Feed a fully attacker-crafted gossip `SingleAttestation` straight into
+    /// the singular-attestation validation + fork-choice mutator, exactly as a
+    /// remote peer would over `beacon_attestation_{subnet_id}`.
+    pub fn poc_on_gossip_single_attestation(
+        &mut self,
+        single: types::electra::containers::SingleAttestation,
+        subnet_id: types::phase0::primitives::SubnetId,
+    ) -> Option<P2pMessage<P>> {
+        self.controller().on_singular_attestation(
+            self.controller().owned_wait_group(),
+            AttestationItem::unverified(
+                Arc::new(Attestation::Single(single)),
+                AttestationOrigin::Gossip(subnet_id, GossipId::default()),
+            ),
+        );
+        self.controller().wait_for_tasks();
+        self.next_p2p_message()
+    }
